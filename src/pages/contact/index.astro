---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Contact NO BALL GAMES | Commission Art, Order Clothing, Grime Art and XRP KIDs Enquiries"
  description="Contact NO BALL GAMES: commission original art, order painted jackets, enquire about Grime Art collaborations, XRP KIDs collector questions and brand partnerships."
  current="contact"
>
  <section class="page-hero">
    <span class="eyebrow">Contact</span>
    <h1>Commission, collect, collaborate.</h1>
    <p>
      Original art commissions, painted clothing orders, Grime Art collaborations, XRP KIDs collector enquiries and brand partnerships — use these routes to get into the right lane.
    </p>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Enquiry routes</h2>
      <p>Put the relevant lane in your subject line for faster handling.</p>
    </div>
    <div class="enquiry-grid">
      <article class="enquiry-card">
        <span class="kicker">Commission original art</span>
        <h3>One-of-one Grime Art paintings</h3>
        <p>Commission a portrait, sign-flip canvas, pop-culture piece or bespoke painted work by Charlie Buster. Include subject idea, preferred size, medium, deadline, delivery location and budget range.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Commission%20original%20art">Email: commission art</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Order painted clothing</span>
        <h3>Hand-painted jackets and wearables</h3>
        <p>Order a one-of-one hand-painted military jacket, denim piece or custom garment. Include garment type, size, quantity, visual references, timeline and budget.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Painted%20clothing%20order">Email: painted clothing</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Grime Art collaborations</span>
        <h3>Brand activation and creative partnerships</h3>
        <p>Propose a Grime Art collaboration, campaign activation, shop launch, event artwork or creative direction project. Share scope, venues/channels, timeline, budget and why it fits the NO BALL GAMES world.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Grime%20Art%20collaboration">Email: Grime Art collab</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">XRP KIDs / lore enquiries</span>
        <h3>Universe, collector and lore questions</h3>
        <p>For XRP KIDs, Alpha Aaron, FRET, $PMSL, Block Buster OG and collector-facing lore questions. Include the story arc or character you are asking about and any relevant collection links.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=XRP%20KIDs%20enquiry">Email: XRP KIDs</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Collector enquiries</span>
        <h3>Physical and digital collecting</h3>
        <p>Questions about specific original artworks, wearable pieces, availability, provenance and digital collectible details. Include collection interests, piece links and budget range.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Collector%20enquiry">Email: collector</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Press / interview / partnerships</span>
        <h3>Media and community collaboration route</h3>
        <p>For press features, interviews, podcasts and community partnerships. Include outlet or platform links, audience profile, requested format, timeline and contact details.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Press%20and%20Partnerships">Email: press &amp; partnerships</a>
      </article>
    </div>
  </section>

  <section class="section split-grid">
    <article class="contact-card">
      <span class="kicker">What to include</span>
      <h2>Send clean details.</h2>
      <ul class="list-clean">
        <li>Who you are and which lane you are enquiring about.</li>
        <li>What you want — commission, order, collaboration or question.</li>
        <li>Timeline and budget context where relevant.</li>
        <li>Any reference images, links, collection interests or supporting detail.</li>
      </ul>
    </article>
    <article class="contact-card">
      <span class="kicker">Before you send</span>
      <ul class="list-clean">
        <li><a class="inline-link" href={`${base}about/`}>About Charlie Buster and Grime Art</a></li>
        <li><a class="inline-link" href={`${base}collections/`}>Collections and collector context</a></li>
        <li><a class="inline-link" href={`${base}xrp/`}>XRP KIDs universe and lore</a></li>
      </ul>
    </article>
  </section>
</BaseLayout>
