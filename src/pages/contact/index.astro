---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Contact NO BALL GAMES | Collaborations, Art, Drops & Community"
  description="Contact NO BALL GAMES for collaborations, art enquiries, digital collectible projects, community ideas, clothing drops and brand opportunities."
  current="contact"
>
  <section class="page-hero">
    <span class="eyebrow">Contact</span>
    <h1>Bring the right idea. Leave the fluff outside.</h1>
    <p>
      Use this page for collaboration enquiries, art opportunities, clothing ideas, digital collectible projects, community campaigns and serious brand conversations.
    </p>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Pick your category</h2>
      <p>Choose the type that best fits your enquiry. Include the category in your subject line for a faster reply.</p>
    </div>
    <div class="enquiry-grid">
      <article class="enquiry-card">
        <span class="kicker">Original art</span>
        <h3>Canvas, board &amp; mixed media</h3>
        <p>Hand-painted works, sign-inspired pieces, character art and studio output. Include your brief, size, budget and timeline.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Art%20commission%20enquiry">Email: art commission</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Painted clothing</span>
        <h3>Jackets, denim &amp; garments</h3>
        <p>One-of-one or small-run pieces. Military jackets, denim, patches and custom wearables. State your piece, quantity and budget.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Clothing%20commission%20enquiry">Email: clothing enquiry</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Brand work</span>
        <h3>Collabs &amp; campaigns</h3>
        <p>Brand identity, creative direction, campaign visuals and collaborative drops. The brief must make sense for the NO BALL GAMES world.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Brand%20collaboration%20enquiry">Email: brand collab</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Community &amp; press</span>
        <h3>Events, interviews &amp; drops</h3>
        <p>Community events, competitions, press enquiries, interviews and collector-related announcements. Include your platform, audience and purpose.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Community%20and%20press%20enquiry">Email: community / press</a>
      </article>
    </div>
  </section>

  <section class="section split-grid">
    <article class="contact-card">
      <span class="kicker">What to include</span>
      <h2>How to write a good message.</h2>
      <p>
        Add your name, project, budget range, timeline, links and the exact reason you want to work with NO BALL GAMES. Clear messages get better replies.
      </p>
      <p>
        No pitches for things that don't fit the brand. No spam. No generic partnership templates.
      </p>
      <div class="cta-row">
        <a class="button secondary" href="mailto:hello@noballgames.com?subject=NO%20BALL%20GAMES%20enquiry">General enquiry</a>
      </div>
    </article>

    <article class="contact-card">
      <span class="kicker">Best fit for contact</span>
      <ul class="list-clean">
        <li>Brand collaborations and campaigns.</li>
        <li>Original art and painted clothing enquiries.</li>
        <li>Digital collectible and Web3 project ideas.</li>
        <li>Community events, competitions and drops.</li>
        <li>Press, interviews and creative partnerships.</li>
        <li>Collector and commission enquiries.</li>
      </ul>
    </article>
  </section>

  <section class="section split-grid">
    <article class="panel-card">
      <span class="kicker">Already know what you want?</span>
      <h2>Make the message short and direct.</h2>
      <p>Send: who you are, what you want, when you need it, what the budget is. That's enough to get a reply.</p>
      <div class="cta-row">
        <a class="button primary" href="mailto:hello@noballgames.com?subject=NO%20BALL%20GAMES%20enquiry">Email now</a>
      </div>
    </article>
    <article class="panel-card">
      <span class="kicker">Explore more first</span>
      <ul class="list-clean">
        <li><a class="inline-link" href={`${base}about/`}>About — learn what the brand stands for</a></li>
        <li><a class="inline-link" href={`${base}projects/`}>Projects — see what is already in motion</a></li>
        <li><a class="inline-link" href={`${base}collections/`}>Collections — physical art and clothing</a></li>
        <li><a class="inline-link" href={`${base}community/`}>Community — get involved as a fan or creator</a></li>
      </ul>
    </article>
  </section>
</BaseLayout>
