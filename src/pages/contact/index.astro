---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Contact NO BALL GAMES | Art, Clothing, Grime Art, XRP KIDs and Collaboration Enquiries"
  description="Contact routes for original art, painted clothing, Grime Art/Charlie Buster enquiries, XRP KIDs lore, source/proof submissions and brand collaborations."
  current="contact"
>
  <section class="page-hero">
    <span class="eyebrow">Contact</span>
    <h1>Send the right enquiry to the right lane.</h1>
    <p>
      Use these routes for original art, painted clothing, Grime Art enquiries, XRP KIDs collector/lore questions, source submissions and brand collaborations.
    </p>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Enquiry routes</h2>
      <p>Pick one lane in your subject line for faster handling.</p>
    </div>
    <div class="enquiry-grid">
      <article class="enquiry-card">
        <span class="kicker">Original art</span>
        <h3>One-of-one paintings and commissions</h3>
        <p>Include desired format, size, timeline and budget range.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Original%20art%20enquiry">Email: original art</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Painted clothing</span>
        <h3>Jackets, denim and wearable work</h3>
        <p>Include garment type, quantity, deadline and visual direction.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Painted%20clothing%20enquiry">Email: painted clothing</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Grime Art / Charlie Buster</span>
        <h3>Artist and visual language enquiries</h3>
        <p>Use this lane for interviews, artist-profile requests and Grime Art context questions.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Grime%20Art%20and%20Charlie%20Buster%20enquiry">Email: Grime Art</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">XRP KIDs / lore / collectors</span>
        <h3>Canon and collector route</h3>
        <p>For XRP KIDs, Alpha Aaron, FRET, $PMSL, Block Buster OG and collector-facing clarifications.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=XRP%20KIDs%20lore%20collector%20enquiry">Email: XRP KIDs</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Source/proof submissions</span>
        <h3>Help verify claims</h3>
        <p>Send source URLs, archive captures, records or corrections with exact page/file references.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Source%20proof%20submission">Email: source proof</a>
      </article>
      <article class="enquiry-card">
        <span class="kicker">Brand collaborations</span>
        <h3>Campaigns and cultural activations</h3>
        <p>Share scope, timeline, deliverables and why the partnership fits NO BALL GAMES culture.</p>
        <a class="button primary" href="mailto:hello@noballgames.com?subject=Brand%20collaboration%20enquiry">Email: brand collaboration</a>
      </article>
    </div>
  </section>

  <section class="section split-grid">
    <article class="contact-card">
      <span class="kicker">Message checklist</span>
      <h2>Send clean details.</h2>
      <ul class="list-clean">
        <li>Who you are and what lane you are enquiring about.</li>
        <li>What deliverable or answer you need.</li>
        <li>Timeline and budget context where relevant.</li>
        <li>Any supporting links, references or proof attachments.</li>
      </ul>
    </article>
    <article class="contact-card">
      <span class="kicker">Before you send</span>
      <ul class="list-clean">
        <li><a class="inline-link" href={`${base}collections/`}>Collections context</a></li>
        <li><a class="inline-link" href={`${base}xrp/`}>XRP lore and disclaimers</a></li>
        <li><a class="inline-link" href={`${base}research/`}>Truth files and source notes</a></li>
      </ul>
    </article>
  </section>
</BaseLayout>
