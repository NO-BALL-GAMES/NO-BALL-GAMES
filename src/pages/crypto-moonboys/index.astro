---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const layers = [
  {
    number: '01',
    title: 'Graffiti Kings / GKniftyHEADS',
    text: 'More than four decades of Graffiti Kings culture underpin the public creator umbrella. GKniftyHEADS is the leading Moonboy identity foundation; characters and collections are not the entire mission.',
    href: 'https://cryptomoonboys.com/about/',
    label: 'Read the current mission',
  },
  {
    number: '02',
    title: 'Two paths / One connected universe',
    text: 'Build a GK Moonboy or Fly Girl world, or keep your original character, art, band, business or brand and develop its unique lore inside the same universe. No compulsory NFT, Moonboy or Arcade gate for existing IP.',
    href: 'https://cryptomoonboys.com/ai-user.html',
    label: 'Start the creator journey',
  },
  {
    number: '03',
    title: 'The public SPARKY starter',
    text: 'The public Creator Studio offers a portable campaign brief for ChatGPT, Claude, Gemini, Grok, Copilot or another capable AI. The website does not host a running SWARMSY chatbot, and project files do not synchronise automatically.',
    href: 'https://cryptomoonboys.com/ai-user.html',
    label: 'Open the public AI starter',
  },
  {
    number: '04',
    title: 'SWARMSY PC / Private creator work',
    text: 'SWARMSY is a separate, optional PC beta built on an AnythingLLM foundation. SPARKY helps with positioning, planning, approved truths and proof review; a local model or user-configured API must actually be installed or connected.',
    href: 'https://cryptomoonboys.com/swarmsy.html',
    label: 'Understand the optional PC beta',
  },
  {
    number: '05',
    title: 'Games, factions, WAX and real rights',
    text: 'Telegram-linked participation, Arcade, Battle Chamber, MoonPet and Block Topia are supporting layers with their own rules. WAX assets can record provenance; only qualifying 1/1 character licences have the published commercial rights.',
    href: 'https://cryptomoonboys.com/my-moonboy.html',
    label: 'Explore current participation',
  },
  {
    number: '06',
    title: 'Public wiki / Year 3008 canon',
    text: 'The living wiki keeps creator references and fictional history distinct. Its current story has the All City Bulls, Nomad Bears, Bitcoin Kid Army and GKniftyHEADS command; Army membership and HODL musters are not separate GK street factions.',
    href: 'https://cryptomoonboys.com/wiki/crypto-moonboys.html',
    label: 'Read the current story',
  },
];
const sources = [
  { label: 'Official Crypto Moonboys website', href: 'https://cryptomoonboys.com/' },
  { label: 'Current mission — What is Crypto Moonboys?', href: 'https://cryptomoonboys.com/about/what-is-crypto-moonboys.html' },
  { label: 'Public SPARKY creator starter — any browser AI', href: 'https://cryptomoonboys.com/ai-user.html' },
  { label: 'Current SPARKY creator-campaign guide', href: 'https://cryptomoonboys.com/guides/sparky/creator-campaign.md' },
  { label: 'SWARMSY PC beta — separate private workspace', href: 'https://cryptomoonboys.com/swarmsy.html' },
  { label: 'Crypto Moonboys — official fictional wiki overview', href: 'https://cryptomoonboys.com/wiki/crypto-moonboys.html' },
  { label: 'Current November 2026 canon and brand vision', href: 'https://cryptomoonboys.com/about/latest-canon-and-brand-vision.md' },
  { label: 'Charlie Buster — Crypto Moonboys wiki', href: 'https://cryptomoonboys.com/wiki/charlie-buster.html' },
  { label: 'Graffiti Kings companion archive', href: 'https://graffitikings.com/pages/crypto-moonboys-gkniftyheads-network.html' },
  { label: 'Graffiti Kings — historic WAX collection identifiers', href: 'https://graffitikings.com/pages/graffiti-kings-wax-nft-collections.html' },
  { label: 'Graffiti Kings — press and art-source archive', href: 'https://graffitikings.com/pages/graffiti-kings-web-network.html' },
];
---
<BaseLayout
  title="Crypto Moonboys | Graffiti Kings, WAX & Creator Worlds — NO BALL GAMES"
  description="Current Crypto Moonboys mission: two creator-owned worldbuilding routes, SPARKY with any browser AI, optional SWARMSY PC, WAX, Graffiti Kings and the updated Year 3008 fiction."
  current="more"
>
  <section class="page-hero moonboys-hero">
    <div class="moonboys-topline">
      <span class="eyebrow">Connected project / Graffiti Kings / WAX</span>
      <span class="moonboys-coordinate">THE WALL → THE WORLD</span>
    </div>
    <h1>CRYPTO <span class="moonboys-highlight">MOONBOYS</span></h1>
    <p class="moonboys-lead">ONE UNIVERSE. <strong>YOUR IP OR OURS. BUILD CONNECTED WORLDS TOGETHER.</strong></p>
    <p>Crypto Moonboys is the <strong>Graffiti Kings public creator umbrella</strong> for identity, visibility, ownership, proof, community and creative momentum. Build a new GK Moonboy or Fly Girl sub-world, or bring your own IP and unique lore into the same shared universe. The website, wiki, game layers, WAX assets and AI tools support that mission; none of them defines the whole project.</p>
    <p>Charlie Buster’s NO BALL GAMES is an independent artist-led identity with shared Graffiti Kings roots. Its XRP KIDs world is a separate XRPL project, not another name for the WAX Moonboys.</p>
    <div class="cta-row">
      <a class="button primary" href="https://cryptomoonboys.com/" target="_blank" rel="noopener noreferrer">Enter Crypto Moonboys ↗</a>
      <a class="button secondary" href="https://cryptomoonboys.com/ai-user.html" target="_blank" rel="noopener noreferrer">Start with any browser AI ↗</a>
    </div>
    <div class="moonboys-strip" aria-label="The Crypto Moonboys approach">
      <span>STREET ART</span><span>IDENTITY</span><span>WAX</span><span>GAMES</span><span>AI</span><span>WORLD-BUILDING</span>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Not just an NFT collection.</h2>
      <p>The current mission is helping creators turn a name, character or existing idea into a recognisable public identity, supported by original work, proof and sustained action. The token, game and AI layers are optional tools.</p>
    </div>
    <div class="split-grid">
      <article class="panel-card">
        <span class="kicker">Before the blockchain</span>
        <h3>Graffiti Kings built the cultural foundation.</h3>
        <p>Names, tags, crews, murals, music and public marks shaped the Graffiti Kings approach to identity and recognition. The Crypto Moonboys project describes this as a culture developed over more than four decades, now extended through GKniftyHEADS into digital characters and creator communities.</p>
        <p>The underlying idea is familiar to graffiti writers: showing up repeatedly makes a mark recognisable. The new tools change the surface, not the need for original work.</p>
      </article>
      <article class="panel-card">
        <span class="kicker">The bigger creative idea</span>
        <h3>Your IP or ours. Build worlds together.</h3>
        <p>Both routes build connected creator worlds. Start with a GK Moonboy or Fly Girl identity you have the rights to use, or preserve your own artist name, character, business, product or brand and connect its unique story to the universe with your approval.</p>
        <p>You direct the identity, work and approved story connections. You keep the IP you bring; using a GK character follows its published licence. An original-IP creator does not need an NFT, a wallet, Telegram login, Arcade XP or a Moonboy to begin. Official shared lore is reviewed, not automatically accepted.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Two ways to build.</h2>
      <p>Both paths join the same Crypto Moonboys world. Choose a new character or retain your existing IP; neither requires a hosted chatbot or a guaranteed reward.</p>
    </div>
    <div class="project-grid">
      <article class="feature-card moonboys-route">
        <span class="moonboys-step" aria-hidden="true">01</span>
        <span class="kicker">Start with a GK character</span>
        <h3>Build a Moonboy or Flygirl world.</h3>
        <p>Start with one GK Moonboy or Fly Girl identity you have permission to use. Name the character and clan, develop a distinct emblem and a short story, then make original art and a recognisable public signal. Optional game, faction and Telegram participation are separate from this creative first step.</p>
        <p>Creative drafts do not prove a qualifying 1/1 licence or HODL Warrior status. Asset-specific ownership, commercial terms, progression and game rewards must be checked against the published rules and live eligibility.</p>
        <a class="inline-link" href="https://cryptomoonboys.com/ai-user.html" target="_blank" rel="noopener noreferrer">Start a character and faction with SPARKY ↗</a>
      </article>
      <article class="feature-card moonboys-route">
        <span class="moonboys-step" aria-hidden="true">02</span>
        <span class="kicker">Keep the identity you already have</span>
        <h3>Bring your own IP.</h3>
        <p>Already an artist, graffiti writer, musician, filmmaker, designer, photographer, product maker or business? Keep your identity and ownership. Develop its own story, message, assets and proposed connections to the wider Crypto Moonboys universe.</p>
        <p>Start with the public, portable SPARKY brief and your chosen browser AI—or create manually. SWARMSY PC is an optional separate beta, not a website-hosted AI. The user approves publication and the community reviews additions to shared canon.</p>
        <a class="inline-link" href="https://cryptomoonboys.com/ai-user.html" target="_blank" rel="noopener noreferrer">Open the current public SPARKY starter ↗</a>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>From one character to a real public world.</h2>
      <p>The updated 20 November SPARKY brief gives would-be faction builders a short, practical starting sequence. A proposal is not automatic admission to the official wiki.</p>
    </div>
    <div class="project-grid">
      <article class="feature-card">
        <span class="kicker">01 / Character and clan</span>
        <h3>Name it. Mark it.</h3>
        <p>Lead with one GK character you have rights to use, or one original character. Choose a character name, faction or clan name, distinct marks or mascots, and a short origin connected to Moonboys lore.</p>
      </article>
      <article class="feature-card">
        <span class="kicker">02 / Art and launch message</span>
        <h3>Make something people remember.</h3>
        <p>Create a hero image, X avatar/banner, three punchy tagline options and two clearly fictional spoof posts. Draw the artwork yourself with AI guidance or use image tools your chosen AI actually supports.</p>
      </article>
      <article class="feature-card">
        <span class="kicker">03 / Publish your own identity</span>
        <h3>Build a small public wiki.</h3>
        <p>Publish an editable one-page faction wiki using GitHub Pages, with lore, artwork, creator credits and links. Open the branded X account and pin an introduction linking back to the live wiki.</p>
      </article>
      <article class="feature-card">
        <span class="kicker">04 / Community and review</span>
        <h3>Show the work first.</h3>
        <p>Share the live wiki and branded X profile together in the GKniftyHEADS Telegram community for feedback. Only after you explicitly request submission should an AI prepare a main-wiki proposal for community review. It must not submit or declare official canon by itself.</p>
      </article>
    </div>
    <p class="moonboys-followup"><strong>No AI provider lock-in:</strong> the public guide works with ChatGPT, Claude, Gemini, Grok, Copilot, another capable browser AI—or manual work. Keep your editable artwork, sources and project brief so you can continue elsewhere; there is no automatic browser-AI-to-SWARMSY memory sync.</p>
    <div class="cta-row">
      <a class="button primary" href="https://cryptomoonboys.com/ai-user.html" target="_blank" rel="noopener noreferrer">Start with the official SPARKY brief ↗</a>
      <a class="button secondary" href="https://cryptomoonboys.com/guides/sparky/creator-campaign.md" target="_blank" rel="noopener noreferrer">Read the full creator workflow ↗</a>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Inside the multiverse.</h2>
      <p>Six connected layers, each with its own rules and purpose.</p>
    </div>
    <div class="card-grid">
      {layers.map((layer) => (
        <article class="feature-card moonboys-layer">
          <span class="moonboys-index">{layer.number} / GK UNIVERSE</span>
          <h3>{layer.title}</h3>
          <p>{layer.text}</p>
          <a class="inline-link" href={layer.href} target="_blank" rel="noopener noreferrer">{layer.label} ↗</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>The market factions. The Army. The Forty.</h2>
      <p>Current <strong>fictional</strong> command structure, confirmed in the Moonboys canon on 16 November 2026. These characters and ranks do not describe real people’s family history, government or military authority.</p>
    </div>
    <div class="card-grid">
      <article class="feature-card">
        <span class="kicker">The two market factions</span>
        <h3>All City Bulls / Nomad Bears.</h3>
        <p>Two central market cultures represent crypto’s opposing bulls and bears. Their members remain distinct people and factions within the fictional world.</p>
      </article>
      <article class="feature-card">
        <span class="kicker">Undercover protection</span>
        <h3>Bitcoin Kid Army.</h3>
        <p>Led by Alfie “The Bitcoin KiD” Blaze, the Army shadows Bulls and Bears around the clock. Alfie takes orders only from GKniftyHEADS. <strong>The Army is a market-protection army, not another GK street faction.</strong></p>
      </article>
      <article class="feature-card">
        <span class="kicker">Political structure</span>
        <h3>GKniftyHEADS + 2 + 37.</h3>
        <p>GKniftyHEADS sit above the two main market factions and 37 other GK factions: <strong>1 + 2 + 37 = 40</strong> in the current political structure. Military units and temporary combined forces do not add faction seats.</p>
      </article>
    </div>
    <div class="split-grid moonboys-canon-followup">
      <article class="panel-card">
        <span class="kicker">United underworld army</span>
        <h3>HODL Warriors are not a faction.</h3>
        <p>When a larger force is needed, members from all GK factions come together as HODL Warriors, keeping their original affiliations. Each aspires to the distinct HODL X Warriors of Block Topia; aspiration is not qualification.</p>
      </article>
      <article class="panel-card">
        <span class="kicker">Inside Block Topia</span>
        <h3>HODL X, Queen Sarah and NULL.</h3>
        <p>HODL X Warriors belong to Queen Sarah P-fly’s Block Topia world alongside her Crypto Moongirls army. Bitcoin X Kids are the engineered inside generation; some escape to join Alfie’s Army. NULL THE PROPHET remains a threat and the public Final Fork is unresolved.</p>
      </article>
    </div>
    <p class="moonboys-followup">The historical forty-culture reading is broader than the exact political roster. Do not count the Bitcoin Kid Army, HODL Warriors or HODL X Warriors as extra GK street factions, and do not treat any of these story roles as creator-licence entitlements.</p>
    <a class="inline-link" href="https://cryptomoonboys.com/wiki/crypto-moonboys.html#market-factions-and-command" target="_blank" rel="noopener noreferrer">Read the official market-factions and command section ↗</a>
  </section>

  <section class="section split-grid">
    <article class="panel-card">
      <span class="kicker">Charlie Buster / Real-world artist</span>
      <h2>The artist connection.</h2>
      <p>Charlie Buster, also known as BUSTER, is linked through his Graffiti Kings background, street-art commissions, Grime Art practice and the NO BALL GAMES project. The Crypto Moonboys Charlie Buster wiki discusses his Leake Street work and his distinctive <strong>Busterisms</strong>: bold colour, cartoons, humour, zigzags, arrows and graphic contrasts.</p>
      <p>The same wiki connects him with NO BALL GAMES WAX artwork and the <strong>XRP KIDs</strong> Genesis description on the XRP Ledger, while distinguishing his real artwork from characters bearing his name in fictional Year 3008 stories.</p>
      <a class="inline-link" href="https://cryptomoonboys.com/wiki/charlie-buster.html" target="_blank" rel="noopener noreferrer">Read Charlie Buster’s Moonboys wiki entry ↗</a>
      <a class="inline-link moonboys-inline-secondary" href={`${base}charlie-buster-biography/`}>Explore his NO BALL GAMES biography →</a>
      <a class="inline-link moonboys-inline-secondary" href={`${base}charlie-buster-online-archive/#chains`}>Explore linked artist and WAX records →</a>
    </article>
    <article class="panel-card">
      <span class="kicker">Independent worlds / Shared history</span>
      <h2>Related. Not identical.</h2>
      <div class="moonboys-brand-list">
        <p><strong>Crypto Moonboys:</strong> Graffiti Kings’ public creator umbrella for building identities, visibility, proof, community and worlds. WAX characters, the wiki, public SPARKY starter, games and Year 3008 fiction are supporting layers.</p>
        <p><strong>NO BALL GAMES:</strong> Charlie Buster’s distinct art and street-culture identity, painted work, sign-flip projects and connected digital initiatives.</p>
        <p><strong>XRP KIDs:</strong> Charlie-associated XRPL Genesis artwork with its own separate fictional character universe and lore. It is not the same as GKniftyHEADS or the Moonboy WAX collections.</p>
      </div>
      <a class="inline-link" href={`${base}xrp/`}>Explore the NO BALL GAMES XRP KIDs world →</a>
    </article>
  </section>

  <section class="section">
    <div class="moonboys-disclosure">
      <span class="kicker">Ownership / Live features / Fiction</span>
      <h3>Different layers. Different rules.</h3>
      <p>WAX assets and XRP Ledger assets are separate. Creators keep the original IP they bring; GK character use follows an applicable published licence. NFT ownership alone does not transfer copyright, all brand rights, guaranteed royalties or access to future features. Qualifying 1/1 character rights are asset-specific. Telegram missions, XP, rewards and game features depend on current rules and deployment status. The Year 3008 story is fiction—not real financial transactions, actual military command, or a forecast. Public SPARKY runs in your chosen browser AI; SWARMSY PC does not automatically synchronise projects with it.</p>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Follow the source.</h2>
      <p>Updated against the current Crypto Moonboys mission, 20 November 2026 SPARKY workflow, and the 16 November 2026 approved fictional command structure. Source pages document project direction; they are not evidence of every live reward, commercial entitlement or deployed feature.</p>
    </div>
    <div class="project-grid">
      {sources.map((source) => (
        <article class="feature-card moonboys-source">
          <h3>{source.label}</h3>
          <a class="inline-link" href={source.href} target="_blank" rel="noopener noreferrer">Open source ↗</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section cta-block">
    <div class="cta-block-inner">
      <span class="eyebrow">One shared culture. Different ways to create.</span>
      <h2>Make your mark. Build your world.</h2>
      <p>Start with the original Crypto Moonboys project, or explore the art and stories of NO BALL GAMES.</p>
      <div class="cta-row">
        <a class="button primary" href="https://cryptomoonboys.com/" target="_blank" rel="noopener noreferrer">Visit Crypto Moonboys ↗</a>
        <a class="button secondary" href={`${base}projects/`}>See NO BALL GAMES projects</a>
      </div>
    </div>
  </section>

  <style>
    .moonboys-hero { background: radial-gradient(circle at 88% 20%, rgba(215,255,47,.21), transparent 38%), radial-gradient(circle at 15% 82%, rgba(47,255,227,.15), transparent 52%), linear-gradient(140deg, rgba(255,47,143,.13), rgba(255,255,255,.025)); }
    .moonboys-topline { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .moonboys-coordinate { font-size: .79rem; font-weight: 900; color: var(--cyan); letter-spacing: .12em; }
    .moonboys-hero h1 { font-size: clamp(3.1rem, 9vw, 7.6rem); line-height: .94; overflow-wrap: anywhere; }
    .moonboys-highlight { display: block; color: var(--acid); }
    .moonboys-lead { font-size: clamp(1.25rem, 2.6vw, 1.75rem) !important; color: var(--text); }
    .moonboys-lead strong { color: var(--acid); }
    .moonboys-strip { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 36px; }
    .moonboys-strip span { padding: 8px 12px; border: 1px solid rgba(215,255,47,.3); border-radius: 9px; background: rgba(5,5,5,.5); color: var(--acid); font-weight: 900; letter-spacing: .09em; font-size: .74rem; }
    .moonboys-route { border-top: 3px solid var(--acid); }
    .moonboys-step { display: block; margin-bottom: 18px; color: var(--acid); font-size: clamp(3.5rem, 8vw, 6rem); font-weight: 900; line-height: .9; letter-spacing: -.08em; }
    .moonboys-layer { display: flex; flex-direction: column; }
    .moonboys-layer .inline-link { margin-top: auto; padding-top: 16px; }
    .moonboys-index { display: block; margin-bottom: 16px; font-size: .8rem; font-weight: 900; letter-spacing: .1em; color: var(--cyan); }
    .moonboys-brand-list { display: grid; gap: 7px; }
    .moonboys-brand-list strong { color: var(--acid); }
    .moonboys-inline-secondary { display: block; }
    .moonboys-followup { max-width: 960px; margin-top: 22px; padding-left: 16px; border-left: 3px solid var(--acid); }
    .moonboys-followup strong { color: var(--text); }
    .moonboys-canon-followup { margin-top: 18px; }
    .moonboys-disclosure { padding: clamp(22px, 4vw, 36px); border-radius: var(--radius); border: 1px solid rgba(47,255,227,.3); background: rgba(47,255,227,.045); }
    .moonboys-disclosure h3 { line-height: 1.1; }
    .moonboys-disclosure p { margin-bottom: 0; }
    .moonboys-source h3 { font-size: clamp(1.25rem, 2.5vw, 1.7rem); line-height: 1.15; }
    @media (max-width: 560px) { .moonboys-hero h1 { font-size: clamp(2.7rem, 13vw, 4.4rem); } .moonboys-strip { gap: 6px; } }
  </style>
</BaseLayout>
