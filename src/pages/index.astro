<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Charlie Buster | NO BALL GAMES</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Orbitron', system-ui, sans-serif;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    .hero-bg {
      animation: rainbowShift 12s linear infinite;
      background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #00ffff, #0000ff, #8b00ff);
      background-size: 700% 700%;
      height: 100vh;
      width: 100vw;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    @keyframes rainbowShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .title {
      font-size: clamp(5rem, 14vw, 12rem);
      font-weight: 900;
      letter-spacing: -0.08em;
      text-align: center;
      animation: textRainbow 8s linear infinite;
    }
    @keyframes textRainbow {
      0% { filter: hue-rotate(0deg); }
      100% { filter: hue-rotate(360deg); }
    }
  </style>
</head>
<body>
  <div class="hero-bg text-white">
    <div class="text-center px-6 max-w-5xl">
      <h1 class="title">CHARLIE BUSTER</h1>
      <p class="mt-4 text-3xl md:text-4xl font-medium tracking-[0.15em]">NO BALL GAMES • GRIME ART ARCHIVE</p>

      <div class="mt-20 max-w-xl mx-auto">
        <h2 class="text-4xl font-medium">WELCOME TO THE ARCHIVE</h2>
        <p class="mt-6 text-xl text-white/90">Grime art, street culture, and raw energy from Charlie Buster.</p>
      </div>

      <div class="mt-16 flex flex-wrap justify-center gap-6">
        <a href="/research" class="px-10 py-5 bg-white text-black rounded-3xl font-medium text-xl hover:scale-105 transition">ENTER THE VAULT →</a>
        <a href="/about" class="px-10 py-5 border-2 border-white rounded-3xl font-medium text-xl hover:bg-white hover:text-black transition">ABOUT THE ARTIST</a>
      </div>
    </div>
  </div>
</body>
</html>
