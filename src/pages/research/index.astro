---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const repoBase = 'https://github.com/NO-BALL-GAMES/NO-BALL-GAMES/blob/main/research';
const truthFiles = [
  {
    title: 'NO BALL GAMES truth baseline',
    label: 'Brand truth',
    href: `${repoBase}/truth.md`,
    summary: 'Canonical baseline for sign-flip identity, public-safe claims and source-needed guardrails around founder/token narratives.',
    use: 'Homepage, about, projects and collections positioning.',
  },
  {
    title: 'Charlie Buster / Grime Art truth baseline',
    label: 'Artist truth',
    href: `${repoBase}/grimeartist-truth.md`,
    summary: 'Defines Grime Art as the raw UK visual layer and sets careful language for Charlie Buster history and collaboration claims.',
    use: 'About page artist framing, project lanes and enquiry wording.',
  },
  {
    title: 'XRP NO BALL GAMES truth baseline',
    label: 'XRPL truth',
    href: `${repoBase}/xrp-noballgames-truth.md`,
    summary: 'Locks the XRP KIDs canon (100/89/11), Alpha Aaron, FRET, $PMSL and Block Buster OG while requiring verification for chain-specific claims.',
    use: 'Lore, XRP, community and collector-proof sections.',
  },
  {
    title: 'Content rights and licensing policy',
    label: 'Rights policy',
    href: `${repoBase}/content-rights.md`,
    summary: 'Sets paraphrase, attribution, quoting and image-rights standards for public publishing.',
    use: 'Public copy discipline and source attribution standards.',
  },
];
---
<BaseLayout
  title="NO BALL GAMES Research Vault | Truth Files, Rights Policy and Source Index"
  description="Index of NO BALL GAMES truth markdown files and rights policy used to shape public pages with clear lore-versus-proof discipline."
  current="research"
>
  <section class="page-hero">
    <span class="eyebrow">Research vault</span>
    <h1>Source files first. Public pages second.</h1>
    <p>
      This page remains the index for the markdown truth files. The public site now rewrites key material into polished pages, while this vault stays the canonical source register.
    </p>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Markdown source index</h2>
      <p>Use these files before adding copy to public pages.</p>
    </div>
    <div class="card-grid">
      {truthFiles.map((file) => (
        <article class="feature-card">
          <span class="kicker">{file.label}</span>
          <h3>{file.title}</h3>
          <p>{file.summary}</p>
          <p><strong>Used for:</strong> {file.use}</p>
          <a class="inline-link" href={file.href}>Open markdown source →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section split-grid">
    <article class="panel-card">
      <span class="kicker">How this vault works</span>
      <h2>Verified vs internal canon vs source needed.</h2>
      <ul class="list-clean">
        <li><strong>Verified:</strong> claims with accessible support.</li>
        <li><strong>Internal canon:</strong> accepted story truth inside the brand universe.</li>
        <li><strong>Source needed:</strong> not yet ready as hard public fact.</li>
      </ul>
      <p>
        This separation keeps lore vivid while avoiding fake certainty in public-facing copy.
      </p>
    </article>

    <article class="panel-card">
      <span class="kicker">Public pages now using this source material</span>
      <ul class="list-clean">
        <li><a class="inline-link" href={`${base}`}>Homepage pillar integration</a></li>
        <li><a class="inline-link" href={`${base}about/`}>About Grime Art depth section</a></li>
        <li><a class="inline-link" href={`${base}projects/`}>Project lane map</a></li>
        <li><a class="inline-link" href={`${base}collections/`}>Collector pathways and warnings</a></li>
        <li><a class="inline-link" href={`${base}lore/`}>Internal XRP canon framing</a></li>
        <li><a class="inline-link" href={`${base}xrp/`}>Expanded XRP timeline and disclaimers</a></li>
      </ul>
    </article>
  </section>
</BaseLayout>
